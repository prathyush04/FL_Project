{
  "info": {
    "name": "FL Backend Manual Testing",
    "description": "Postman collection for manually testing the currently implemented Spring backend endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
                  "const json = pm.response.json();",
                  "if (json && json.token) {\n  pm.environment.set(\"token\", json.token);\n}\n" 
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login as Hospital User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"hospital1\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
                  "const json = pm.response.json();",
                  "if (json && json.token) {\n  pm.environment.set(\"hospitalToken\", json.token);\n}\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Get All Clients (Admin only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "clients"
              ]
            }
          }
        },
        {
          "name": "Get My Client (Hospital user)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "clients",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Metrics",
      "item": [
        {
          "name": "Get Global Metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/metrics/global?sessionId={{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "metrics",
                "global"
              ],
              "query": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Comparison Metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/metrics/comparison?sessionId={{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "metrics",
                "comparison"
              ],
              "query": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Model",
      "item": [
        {
          "name": "Get Active Model Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/model/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "model",
                "info"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Prediction",
      "item": [
        {
          "name": "Run Prediction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 62,\n  \"sex\": \"M\",\n  \"bmi\": 28.4,\n  \"smoking\": true,\n  \"blood_pressure\": 138\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "predict"
              ]
            }
          }
        },
        {
          "name": "Get My Predictions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/predictions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "predictions"
              ]
            }
          }
        },
        {
          "name": "Get All Predictions (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/predictions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "predictions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Training",
      "item": [
        {
          "name": "Start Training",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/training/start?totalRounds=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "training",
                "start"
              ],
              "query": [
                {
                  "key": "totalRounds",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {\n  pm.environment.set(\"sessionId\", json.id);\n}\n"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Training Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/training/status?sessionId={{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "training",
                "status"
              ],
              "query": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "hospitalToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "1",
      "type": "string"
    }
  ]
}
