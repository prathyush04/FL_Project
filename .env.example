# =============================================================================
# Spring Boot Backend — Required Environment Variables
# Set these in your Render service's "Environment" tab
# =============================================================================

# --- Database (auto-filled by Render if using render.yaml with linked DB) ---
DB_URL=jdbc:postgresql://<host>:<port>/<dbname>
DB_USERNAME=fl_user
DB_PASSWORD=<your-db-password>
DB_DRIVER=org.postgresql.Driver
JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- JWT ---
# Use a strong random string (min 64 chars). Render can auto-generate this.
JWT_SECRET=<generate-a-strong-random-secret>
JWT_EXPIRATION=86400000

# --- Cross-Service URLs ---
# Set FRONTEND_URL to your Vercel deployment URL (no trailing slash)
FRONTEND_URL=https://<your-project>.vercel.app
# Set ML_SERVICE_URL to your ML service Render URL (no trailing slash)
ML_SERVICE_URL=https://<your-ml-service>.onrender.com

# =============================================================================
# ML Service — Required Environment Variables
# Set these in your Render ML service's "Environment" tab
# =============================================================================

# Path to Render Disk mount for persistent model storage
MODEL_DIR=/var/data/models
# Render sets PORT automatically — no need to set manually
# PORT=8000

# =============================================================================
# Frontend — Required Environment Variables
# Set these in your Vercel project's "Environment Variables" section
# =============================================================================

# Point to your Spring Boot Render service URL (no trailing slash)
VITE_API_URL=https://<your-spring-backend>.onrender.com/api/v1
